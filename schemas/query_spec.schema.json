{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "requested_entities", "requested_fields", "filters", "metrics", "dimensions", "group_by", "order_by", "limit", "backend_preference"],
  "properties": {
    "intent": {"enum": ["detail_export", "aggregate", "count"]},
    "requested_entities": {"type": "array", "items": {"type": "string"}},
    "requested_fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["concept"], "properties": {"concept": {"type": "string", "minLength": 1}}}},
    "filters": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["concept", "operator", "value"], "properties": {"concept": {"type": "string"}, "operator": {"enum": ["equals", "not_equals", "in", "not_in", "gt", "gte", "lt", "lte", "contains"]}, "value": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}]}}}},
    "metrics": {"type": "array", "items": {"type": "string"}},
    "dimensions": {"type": "array", "items": {"type": "string"}},
    "group_by": {"type": "array", "items": {"type": "string"}},
    "order_by": {"type": "array"},
    "limit": {"type": "integer", "minimum": 1},
    "backend_preference": {"enum": ["auto", "data_query", "snowflake"]}
  }
}
